# Copy to .env for local development. NEVER commit real values.
NODE_ENV=development
PORT=3000
# Public address of the portal (used in login links and origin checks)
BASE_URL=http://localhost:3000
DATABASE_URL=postgres://portal:portal@localhost:5432/portal_dev
# The first admin account (created on startup if missing)
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Studio AM Admin
# Email is optional. Sign-in uses email + password. With a Resend key, the older emailed-link sign-in also works.
RESEND_API_KEY=
MAIL_FROM="Studio AM <portal@studio-am.co.za>"
# First admin password (min 12 chars). Used once, only while the account has no password. Remove it from the host afterwards.
ADMIN_PASSWORD=
